# Spotify Developer App credentials (https://developer.spotify.com/dashboard)
# Leave blank or set DEMO_MODE=1 to test the UI with mock data.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match the Redirect URI configured in your Spotify Developer Dashboard.
# Example: http://192.168.1.50:8765/auth/callback (or http://127.0.0.1:8765/auth/callback)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/auth/callback

# Server settings
HOST=0.0.0.0
PORT=8765

# Set to 1 to run with simulated Spotify data (no Spotify account required)
DEMO_MODE=0

# Kindle display defaults (landscape logical size; Kindle client also auto-reports its exact pixels)
# Kindle 10th Gen Basic: 800x600 | Kindle Paperwhite 10th Gen: 1448x1072
SCREEN_WIDTH=800
SCREEN_HEIGHT=600

# Rotation applied before sending PNG to the Kindle portrait framebuffer:
# 90  = USB port on the right (landscape)
# 270 = USB port on the left (landscape)
# 0   = no rotation
ROTATION=90

# Seconds of no music playing before switching to the full-screen Idle Clock (default: 300 = 5 min)
IDLE_TIMEOUT_SECONDS=300

# Volume adjustment per +/- tap (percent)
VOLUME_STEP=10

# Clock format: 24h or 12h
TIME_FORMAT=24h

# Optional path to a custom .ttf font file (auto-discovers DejaVuSans/LiberationSans if unset)
FONT_PATH=
FONT_BOLD_PATH=
