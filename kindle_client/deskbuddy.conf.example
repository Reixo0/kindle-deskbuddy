# Configuration for the Kindle 10th Gen Desk Buddy client
# Copy this file to /mnt/us/deskbuddy/deskbuddy.conf and set PI_URL to your Raspberry Pi's IP.

PI_URL="http://192.168.1.50:8765"

# Landscape rotation matching how you place the Kindle on your desk:
# 90  = USB port on the right
# 270 = USB port on the left
ROTATION="90"

# Full-flashing e-ink refresh every N partial redraws to clear ghosting
FULL_REFRESH_EVERY="15"

# Pause Kindle's home UI while Desk Buddy is running (0 = safe default, 1 = pause UI)
# Keep this 0 while testing so you can always use the power button normally.
PAUSE_KINDLE_UI="0"

# Leave empty to auto-detect touchscreen /dev/input/event*
TOUCH_DEV=""

# Optional touch calibration (leave empty to use native screen pixels)
TOUCH_MAX_X=""
TOUCH_MAX_Y=""
TOUCH_SWAP_XY="0"
TOUCH_INVERT_X="0"
TOUCH_INVERT_Y="0"
